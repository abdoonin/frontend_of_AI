# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules

# backend and training subfolders (deployed separately)
/backend/
/AiLDS_XGBoost_v5/

# next.js
/.next/
/out/

# production
/build

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python bytecode
__pycache__/
*.py[cod]

# live SQLite databases -- these change on every run and would otherwise
# add ~12MB of churn to every commit. The demonstrated-state snapshot is
# preserved in the baseline commit; restore with:
#   git checkout 9534fcd -- backend/medical_ai.db medical_ai.db
*.db
# generated by .verify/ contract probes
.verify/payloads.json
.verify/responses.json
# real patient names and clinical values, exported from the live database by
# .verify/worklist-emit.py -- regenerate it, never commit it
.verify/worklist-data.json

# Isolated dev build dir, so a dev server can run beside a production one
.next-dev
.next-verify

.vscode/
.verify/
demo/
plans/
scripts/
test_*.py
commands.txt
install-pnpm.ps1
